#!/bin/sh
# fml.md installer — https://fml.md
#
#   curl -fsSL https://fml.md/install | sh
#   curl -fsSL https://fml.md/install | sh -s -- opencode
#   curl -fsSL https://fml.md/install | sh -s -- codex --local
#
set -eu

BASE="${FML_BASE:-https://fml.md}"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  A='\033[33m'; D='\033[2m'; R='\033[31m'; O='\033[0m'
else
  A=''; D=''; R=''; O=''
fi

say() { printf '%b\n' "$*"; }
die() { printf '%b\n' "${R}fml:${O} $*" >&2; exit 1; }

usage() {
  say "fml.md installer"
  say ""
  say "  claude         Claude Code        ~/.claude          (default)"
  say "  opencode       opencode           ~/.config/opencode"
  say "  codex          Codex CLI          ~/.agents"
  say "  hermes         Hermes             ~/.hermes"
  say ""
  say "  --global, -g   install for every project"
  say "  --local,  -l   install into this repo only"
  say "  --help,   -h   this"
  say ""
  say "With no harness it assumes Claude Code. With no scope it asks; piped into a"
  say "non-interactive shell, it goes global."
}

if command -v curl >/dev/null 2>&1; then
  fetch() { curl -fsSL "$1" -o "$2"; }
elif command -v wget >/dev/null 2>&1; then
  fetch() { wget -qO "$2" "$1"; }
else
  die "no curl, no wget. Install one."
fi

scope=""
agent="${FML_AGENT:-}"
for arg in "$@"; do
  case "$arg" in
    -g|--global)               scope=global ;;
    -l|--local|--repo|--here)  scope=local ;;
    -h|--help)                 usage; exit 0 ;;
    claude|--claude|claude-code|--claude-code)  agent=claude ;;
    opencode|--opencode)                        agent=opencode ;;
    codex|--codex)                              agent=codex ;;
    hermes|--hermes)                            agent=hermes ;;
    *)                         die "unknown option: $arg" ;;
  esac
done
[ -n "$agent" ] || agent=claude

# label, global root, local root, command filename ("" = skill doubles as the command)
case "$agent" in
  claude)
    label="Claude Code"; groot="$HOME/.claude";          lroot="$PWD/.claude"
    cmdsrc="fml.md";          invoke="/fml" ;;
  opencode)
    label="opencode";   groot="$HOME/.config/opencode";  lroot="$PWD/.opencode"
    cmdsrc="fml.opencode.md"; invoke="/fml" ;;
  codex)
    label="Codex CLI";  groot="$HOME/.agents";           lroot="$PWD/.agents"
    cmdsrc="";                invoke="\$fml" ;;
  hermes)
    label="Hermes";     groot="$HOME/.hermes";           lroot="$PWD/.hermes"
    cmdsrc="";                invoke="/fml" ;;
  *)
    die "don't know that harness: $agent. One of claude, opencode, codex, hermes." ;;
esac

# [ -r /dev/tty ] is a liar when there's no controlling terminal — open it and see.
tty_ok=no
if ( : < /dev/tty ) 2>/dev/null; then
  tty_ok=yes
fi

if [ -z "$scope" ]; then
  if [ "$tty_ok" = yes ]; then
    say ""
    say "  ${label}. Where do you want it?"
    say ""
    say "    ${A}g${O}  global   ${D}$groot — every project${O}"
    say "    ${A}r${O}  repo     ${D}$lroot${O}"
    say ""
    printf '%b' "  [${A}G${O}/r] "
    read -r ans < /dev/tty 2>/dev/null || ans=""
    say ""
    case "$ans" in
      g|G|global|"")      scope=global ;;
      r|R|repo|l|L|local) scope=local ;;
      *)                  die "didn't catch that. Re-run with --global or --local." ;;
    esac
  else
    scope=global
    say "${D}Nothing to read from, so: global. Pass --local to scope it to a repo.${O}"
  fi
fi

if [ "$scope" = global ]; then
  root="$groot"
else
  root="$lroot"
  if [ ! -d .git ]; then
    say "${D}No .git here — installing into $root anyway.${O}"
  fi
fi

skills="$root/skills/fml"
cmds="$root/commands"

verb="installed"
if [ -f "$skills/SKILL.md" ]; then
  verb="updated"
fi

tmp="$(mktemp -d 2>/dev/null || mktemp -d -t fml)"
trap 'rm -rf "$tmp"' EXIT INT TERM

fetch "$BASE/fml/SKILL.md" "$tmp/SKILL.md" || die "couldn't fetch $BASE/fml/SKILL.md"

head -n 3 "$tmp/SKILL.md" | grep -q '^name: fml$' \
  || die "that download wasn't SKILL.md. Check $BASE and try again."

mkdir -p "$skills"
mv "$tmp/SKILL.md" "$skills/SKILL.md"

if [ -n "$cmdsrc" ]; then
  fetch "$BASE/fml/$cmdsrc" "$tmp/cmd.md" || die "couldn't fetch $BASE/fml/$cmdsrc"
  mkdir -p "$cmds"
  mv "$tmp/cmd.md" "$cmds/fml.md"
fi

say ""
say "  ${A}fml $verb for $label.${O}"
say "    ${D}skill  ${O} $skills/SKILL.md"
if [ -n "$cmdsrc" ]; then
  say "    ${D}command${O} $cmds/fml.md"
else
  say "    ${D}command${O} the skill is the command"
fi
say ""
say "  Run ${A}$invoke${O} <question>. Restart $label if it's already open."
say ""
